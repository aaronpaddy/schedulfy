# ===========================================
# Schedulfy Environment Variables
# ===========================================
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to Git!

# OpenAI API Configuration
OPENAI_API_KEY=sk-your-actual-api-key-here

# Flask Configuration
# FLASK_ENV=production switches on secure cross-site session cookies and makes
# a missing SECRET_KEY a hard boot failure. Leave it as development locally.
SECRET_KEY=your-secret-key-here-use-random-string
FLASK_ENV=development
FLASK_DEBUG=True

# Database
# Local default is SQLite. In production set a Postgres URL, e.g.
# postgresql://user:pass@host:5432/schedulfy  ('postgres://' is accepted too)
DATABASE_URL=sqlite:///courses.db

# Application Settings
MAX_CREDITS_PER_SEMESTER=18
DEFAULT_SEMESTER=Fall
DEFAULT_YEAR=2025

# CORS Settings
# Comma-separated list of allowed frontend origins. Include the scheme and use
# no trailing slash, e.g. https://schedulfy-web.onrender.com
CORS_ORIGINS=http://localhost:3000

# Session Configuration
# SameSite/Secure are derived from FLASK_ENV and are not read from here.
PERMANENT_SESSION_LIFETIME=7

# Port (set automatically by most hosts)
# PORT=5003
